{
  "name": "@basketgap/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ping": "tsx --env-file=../../.env.local src/cli.ts ping",
    "ingest": "tsx --env-file=../../.env.local src/cli.ts ingest",
    "enrich-skus": "tsx --env-file=../../.env.local src/cli.ts enrich-skus",
    "match": "tsx --env-file=../../.env.local src/cli.ts match",
    "prune-cache": "tsx --env-file=../../.env.local src/cli.ts prune-cache"
  },
  "dependencies": {
    "@basketgap/shared": "workspace:*",
    "cheerio": "^1.2.0",
    "drizzle-orm": "0.45.2",
    "playwright": "^1.60.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
