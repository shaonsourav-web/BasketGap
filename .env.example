# BasketGap — Supabase project secrets
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

SUPABASE_PROJECT_REF=your-project-ref-here
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_ACCESS_TOKEN=your-supabase-access-token-here

# Workers — transaction pooler connection (port 6543, postgres-js + Drizzle).
# Copy the exact string from Supabase dashboard → Connect → Transaction pooler.
# The pooler host varies by project; don't hand-assemble.
# If your password contains URL-special chars (@ / : ? # %), URL-encode them.
DATABASE_URL=postgresql://postgres.your-ref:your-db-password@your-pooler-host.pooler.supabase.com:6543/postgres

# Sentry — error reporting from worker runs. Optional; observability falls
# through to stderr when unset, so absence is a no-op rather than a silent swallow.
SENTRY_DSN=

# The matching engine has two optional provider tiers, each with its own key.
# Either can be set without the other; with neither, the pipeline runs fully
# offline (trigram-only ranking, rank-only decisions).

# Gemini API key (Google Generative Language API) — EMBEDDINGS tier only:
# gemini-embedding-001, requested at 1536 dims so the existing
# canonical_products.embedding vector(1536) column needs no migration.
# Required to seed the canonical catalogue with vectors (`workers seed
# canonical`). Absent → no vector search (trigram-only).
GEMINI_API_KEY=

# Embedding model override. Changing it requires a re-seed.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI API key — LLM DISAMBIGUATION FALLBACK tier only, used when the
# deterministic ranker can't push the top candidate above the `assumed` band
# (0.55). Responses API with a strict JSON schema: the model must pick a
# shortlist id or decline; out-of-shortlist IDs are rejected before
# persistence. Absent → no LLM fallback (rank-only).
OPENAI_API_KEY=

# LLM model override. Default shown. The request sends reasoning effort `none`
# and temperature 0, so an override must be a Structured-Outputs model that
# accepts effort `none` (gpt-6-luna, gpt-6.1-terra, gpt-6-sol at time of
# writing) — otherwise every fallback call fails with HTTP 400.
# OPENAI_LLM_MODEL=gpt-6-luna

# Ingest plugins — optional. The repository ships one ingest adapter, `import`
# (reads a local .json/.csv file; see docs/ingest-adapters.md). Retailer-specific
# adapters live outside this repository and are loaded at runtime from a
# comma-separated list of module paths (absolute paths are the reliable choice)
# or package names. Unset → only the built-in `import` adapter is available.
# BASKETGAP_INGEST_PLUGINS=/absolute/path/to/your-plugin/src/index.ts

# ─── API package (packages/api) — Vercel Functions ───────────────────────────
# Set in Vercel dashboard, not committed. Local dev reads from .env.local.

# Upstash Redis — sliding-window rate limit keyed on (ip_hash, device_id_hash).
# Provisioned via Vercel Marketplace; integration sets both keys automatically
# in production. For local dev, copy from Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated origin allowlist for browser CORS. Native mobile fetch is
# unaffected. Leave empty to block all browser origins.
# ALLOWED_ORIGINS=https://app.basketgap.example,https://staging.basketgap.example

# Sentry DSN — API-specific. Optional; falls back to stderr-only when unset.
SENTRY_DSN_API=

# Maximum LLM disambiguation calls per /api/match request. Default 10. Lines
# past the cap return decidedBy='rank' / band='needs_attention' / truncated=true.
# MAX_LLM_CALLS_PER_REQUEST=10
