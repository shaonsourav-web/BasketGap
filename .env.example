# BasketGap — Supabase project secrets
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

SUPABASE_PROJECT_REF=your-project-ref-here
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_ACCESS_TOKEN=your-supabase-access-token-here

# Workers — transaction pooler connection (port 6543, postgres-js + Drizzle).
# Copy the exact string from Supabase dashboard → Connect → Transaction pooler.
# The host region prefix (aws-0 / aws-1 / etc.) varies by project; don't hand-assemble.
# If your password contains URL-special chars (@ / : ? # %), URL-encode them.
DATABASE_URL=postgresql://postgres.your-ref:your-db-password@aws-X-region.pooler.supabase.com:6543/postgres

# Sentry — error reporting from worker runs. Optional; observability falls
# through to stderr when unset, so absence is a no-op rather than a silent swallow.
SENTRY_DSN=

# Gemini API key (Google Generative Language API) — the single provider key for
# the matching engine. It enables BOTH tiers:
#   - embeddings (gemini-embedding-001, requested at 1536 dims so the existing
#     canonical_products.embedding vector(1536) column needs no migration);
#   - LLM disambiguation fallback (gemini-2.5-flash) when the deterministic
#     ranker can't push the top candidate above the `assumed` band (0.55).
# Constrained output: the model is schema-forced to pick a shortlist id or
# decline; out-of-shortlist IDs are rejected before persistence.
# Required to seed the canonical catalogue (`workers seed canonical`). Absent →
# the pipeline degrades cleanly: trigram-only ranking, no LLM fallback.
GEMINI_API_KEY=

# Model overrides. Defaults shown; any Gemini model that supports
# responseSchema (LLM) / outputDimensionality (embeddings) is acceptable.
# Changing the embedding model requires a re-seed.
# GEMINI_LLM_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Coles weekly catalogue PDF URL — NOT loaded from this file by the worker.
# Wired into GitHub Actions as a repo Variable (vars.CATALOGUE_URL_COLES) so the
# cron in .github/workflows/ingest-coles-pdf.yml can run unattended. The CLI
# accepts it via --source-url instead. URLs are not secrets, so a Variable (not
# Secret) is the right shape.
# CATALOGUE_URL_COLES=[retailer-url-redacted]

# Woolworths weekly catalogue PDF URL — same shape as the Coles variable, used
# by .github/workflows/ingest-woolies-pdf.yml.
# CATALOGUE_URL_WOOLIES=[retailer-url-redacted]

# Coles "Down Down" web specials page URL — used by the weekly Wednesday cron
# in .github/workflows/ingest-coles-web.yml (see docs/ingest-cadence.md). Wired
# as repo Variable (vars.CATALOGUE_URL_COLES_WEB) since URLs are not secrets.
# CLI accepts it via --source-url instead. Playwright renders the page in
# headless Chromium.
# CATALOGUE_URL_COLES_WEB=[retailer-url-redacted]

# Woolworths web specials page URL — same shape as the Coles web variable. Used
# by .github/workflows/ingest-woolies-web.yml. The old /specials/prices-dropped
# route is dead; the adapter rewrites it, but set the live route directly.
# CATALOGUE_URL_WOOLIES_WEB=[retailer-url-redacted]

# ─── API package (packages/api) — Vercel Functions ───────────────────────────
# Set in Vercel dashboard, not committed. Local dev reads from .env.local.

# Upstash Redis — sliding-window rate limit keyed on (ip_hash, device_id_hash).
# Provisioned via Vercel Marketplace; integration sets both keys automatically
# in production. For local dev, copy from Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated origin allowlist for browser CORS. Native mobile fetch is
# unaffected. Leave empty to block all browser origins.
# ALLOWED_ORIGINS=https://app.basketgap.example,https://staging.basketgap.example

# Sentry DSN — API-specific. Optional; falls back to stderr-only when unset.
SENTRY_DSN_API=

# Maximum LLM disambiguation calls per /api/match request. Default 10. Lines
# past the cap return decidedBy='rank' / band='needs_attention' / truncated=true.
# MAX_LLM_CALLS_PER_REQUEST=10
