{
  "name": "basketgap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "eslint": "10.3.0",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "supabase": "2.98.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "pnpm exec prettier --write"
    ]
  }
}
